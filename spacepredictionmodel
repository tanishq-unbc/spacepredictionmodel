<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Space Colony & Economy Prediction Model</title>

  <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>

  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

  <script src="https://unpkg.com/prop-types@15.8.1/prop-types.min.js"></script>

  <script src="https://unpkg.com/recharts@2.12.7/umd/Recharts.js"></script>

  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: #020617;
      color: #f8fafc;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }
    #root {
      min-height: 100vh;
    }
    /* Simple custom scrollbar for better matching dashboard theme */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #020617;
    }
    ::-webkit-scrollbar-thumb {
      background: #1e293b;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #334155;
    }
  </style>
</head>
<body>

  <div id="root"></div>

  <script type="text/babel">
    // Extract everything from Recharts global object
    const {
      AreaChart, Area, BarChart, Bar,
      XAxis, YAxis, CartesianGrid, Tooltip, Legend,
      ResponsiveContainer, LineChart, Line
    } = Recharts;

    const { useState, useMemo, useRef, useEffect } = React;

    const YEARS = [2025,2030,2035,2040,2045,2050,2055,2060,2065,2070,2075];

    const RAW = {
      cost: {
        moon:  { opt:[45,36,26,18,12,8,6,4.5,3.5,2.8,2.2],  real:[45,50,44,38,32,27,23,19,16,14,12],    pess:[45,62,60,58,57,55,53,51,50,48,47] },
        mars:  { opt:[0,185,145,105,75,54,40,30,23,18,14],   real:[0,0,260,205,165,132,108,88,72,60,50],  pess:[0,0,0,360,318,284,258,235,215,198,184] },
        orbit: { opt:[25,18,12,8,5.5,3.8,2.5,1.8,1.2,0.9,0.6], real:[25,28,24,20,16.5,13.5,11,8.8,7,5.5,4.5], pess:[25,32,31,30,29,28,27,26,25.5,25,24.5] }
      },
      tonnage: {
        moon:  { opt:[250,900,2800,7500,18000,42000,85000,160000,280000,450000,680000], real:[250,450,1100,2600,5800,12000,24000,45000,80000,135000,210000], pess:[250,310,480,720,1100,1800,2900,4600,7200,11000,16500] },
        mars:  { opt:[0,80,450,1900,6500,21000,62000,165000,410000,920000,1950000],    real:[0,0,120,450,1300,3400,8500,20000,46000,98000,195000],     pess:[0,0,0,90,240,550,1100,2100,3900,6800,11500] },
        orbit: { opt:[600,1600,4200,11000,26000,58000,125000,250000,480000,850000,1450000], real:[600,1050,2100,4400,8800,17500,33000,60000,105000,175000,285000], pess:[600,780,1150,1650,2300,3200,4500,6200,8500,11500,15500] }
      },
      population: {
        moon:  { opt:[40,120,380,1100,3200,8500,22000,54000,125000,280000,580000], real:[40,75,180,420,950,2100,4500,9200,18500,36000,68000],   pess:[40,52,70,95,130,175,235,315,420,550,720] },
        mars:  { opt:[0,12,65,280,1100,4200,15000,48000,145000,410000,1100000],   real:[0,0,24,90,290,850,2300,6200,15500,37000,85000],     pess:[0,0,0,18,48,110,240,480,920,1700,3100] },
        orbit: { opt:[150,420,1100,2900,7500,19000,46000,110000,250000,540000,1150000], real:[150,260,520,1100,2200,4500,9000,17500,33000,60000,105000], pess:[150,190,250,330,440,580,760,1000,1300,1700,2200] }
      },
      cadence: {
        moon:  { opt:[12,35,90,220,500,1100,2200,4200,7500,12500,20000], real:[12,20,42,85,175,340,650,1200,2100,3600,6000], pess:[12,14,19,26,35,48,65,88,120,160,215] },
        mars:  { opt:[0,2,8,28,85,240,640,1550,3600,7800,16000],       real:[0,0,3,10,26,62,145,320,680,1400,2800],       pess:[0,0,0,3,7,14,26,48,85,145,240] },
        orbit: { opt:[24,55,130,320,720,1550,3200,6400,12000,22000,38000], real:[24,38,72,135,250,460,820,1450,2500,4200,7000], pess:[24,28,34,42,52,65,82,105,135,175,225] }
      }
    };

    const DEST_INFO = {
      moon:  { name: "Luna Base", desc: "Artemis hub & Helium-3 mining", color: "#38bdf8", bg: "rgba(56,189,248,0.05)" },
      mars:  { name: "Mars Alpha", desc: "Self-sustaining multiplanetary city", color: "#f87171", bg: "rgba(248,113,113,0.05)" },
      orbit: { name: "Orbital Hubs", desc: "O'Neill cylinders & tourism micro-g", color: "#34d399", bg: "rgba(52,211,153,0.05)" }
    };

    const S = {
      container: { maxWidth: 1280, margin: "0 auto", padding: "20px 24px", boxSizing: "border-box" },
      header: { display: "flex", flexWrap: "wrap", justifyContent: "space-between", alignItems: "center", borderBottom: "1px solid #1e293b", paddingBottom: 20, marginBottom: 24, gap: 16 },
      title: { fontSize: 24, fontWeight: 800, letterSpacing: "-0.025em", margin: 0, background: "linear-gradient(to right, #f1f5f9, #94a3b8)", WebkitBackgroundClip: "text", WebkitTextFillColor: "transparent" },
      subtitle: { fontSize: 13, color: "#64748b", marginTop: 4 },
      badge: { background: "#1e1b4b", border: "1px solid #312e81", color: "#c7d2fe", padding: "4px 10px", borderRadius: 12, fontSize: 11, fontWeight: 600, display: "inline-flex", alignItems: "center", gap: 6 },
      tabsContainer: { display: "flex", gap: 6, background: "#0f172a", padding: 4, borderRadius: 8, border: "1px solid #1e293b" },
      tab: (active) => ({ padding: "6px 12px", borderRadius: 6, fontSize: 13, fontWeight: 500, border: "none", cursor: "pointer", background: active ? "#1e293b" : "transparent", color: active ? "#f8fafc" : "#64748b", transition: "all 0.15s ease" }),
      grid: { display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(320px, 1fr))", gap: 16, marginBottom: 24 },
      card: { background: "#0f172a", border: "1px solid #1e293b", borderRadius: 12, padding: 16, position: "relative" },
      scenBtn: (active, color) => ({ flex: 1, padding: "10px 8px", borderRadius: 8, border: "1px solid", borderColor: active ? color : "#1e293b", background: active ? `rgba(${color === "#38bdf8" ? "56,189,248" : color === "#34d399" ? "52,211,153" : "248,113,113"}, 0.1)` : "#090f1c", color: active ? "#f8fafc" : "#475569", cursor: "pointer", fontSize: 12, fontWeight: 600, textAlign: "center", transition: "all 0.15s" }),
      sliderTrack: { width: "100%", height: 6, background: "#1e293b", borderRadius: 3, position: "relative", cursor: "pointer", marginTop: 12, marginBottom: 6 },
      sliderThumb: (pct) => ({ position: "absolute", left: `${pct}%`, top: "50%", transform: "translate(-50%, -50%)", width: 16, height: 16, borderRadius: "50%", background: "#f8fafc", border: "2px solid #3b82f6", boxShadow: "0 0 10px rgba(59,130,246,0.5)", transition: "left 0.1s ease", cursor: "grab" }),
      metricBox: { display: "flex", justifyContent: "space-between", alignItems: "baseline", padding: "10px 12px", background: "#090f1c", borderRadius: 8, border: "1px solid #1e293b" }
    };

    function CustomTooltip({ active, payload, label, valPrefix = "", valSuffix = "" }) {
      if (!active || !payload || !payload.length) return null;
      return (
        <div style={{ background: "rgba(15, 23, 42, 0.95)", border: "1px solid #334155", padding: "10px 14px", borderRadius: 8, boxShadow: "0 10px 25px -5px rgba(0,0,0,0.5)", backdropFilter: "blur(4px)" }}>
          <div style={{ fontSize: 12, fontWeight: 700, color: "#94a3b8", marginBottom: 6 }}>Year {label}</div>
          {payload.map((p, idx) => (
            <div key={idx} style={{ display: "flex", alignItems: "center", gap: 8, fontSize: 12, marginTop: idx > 0 ? 4 : 0 }}>
              <div style={{ width: 8, height: 8, borderRadius: "50%", background: p.color || p.fill }} />
              <span style={{ color: "#64748b" }}>{p.name}:</span>
              <span style={{ fontWeight: 600, color: "#f1f5f9" }}>
                {valPrefix}{p.value.toLocaleString(undefined, { maximumFractionDigits: 1 })}{valSuffix}
              </span>
            </div>
          ))}
        </div>
      );
    }

    function App() {
      const [dest, setDest] = useState("moon");
      const [scen, setScen] = useState("real");
      const [yearIdx, setYearIdx] = useState(5); // Default to 2050
      const trackRef = useRef(null);

      const activeYear = YEARS[yearIdx];

      const currentMetrics = useMemo(() => {
        return {
          cost: RAW.cost[dest][scen][yearIdx],
          tonnage: RAW.tonnage[dest][scen][yearIdx],
          population: RAW.population[dest][scen][yearIdx],
          cadence: RAW.cadence[dest][scen][yearIdx]
        };
      }, [dest, scen, yearIdx]);

      const timeSeriesData = useMemo(() => {
        return YEARS.map((yr, idx) => ({
          year: yr,
          cost: RAW.cost[dest][scen][idx],
          tonnage: RAW.tonnage[dest][scen][idx],
          population: RAW.population[dest][scen][idx],
          cadence: RAW.cadence[dest][scen][idx]
        }));
      }, [dest, scen]);

      const globalCompareData = useMemo(() => {
        return YEARS.map((yr, idx) => ({
          year: yr,
          moon: RAW.population.moon[scen][idx],
          mars: RAW.population.mars[scen][idx],
          orbit: RAW.population.orbit[scen][idx]
        }));
      }, [scen]);

      const handleTrackMouseDown = (e) => {
        if (!trackRef.current) return;
        const rect = trackRef.current.getBoundingClientRect();
        const updatePosition = (clientX) => {
          let pct = (clientX - rect.left) / rect.width;
          pct = Math.max(0, Math.min(1, pct));
          const idx = Math.round(pct * (YEARS.length - 1));
          setYearIdx(idx);
        };
        updatePosition(e.clientX);

        const handleMouseMove = (em) => updatePosition(em.clientX);
        const handleMouseUp = () => {
          window.removeEventListener("mousemove", handleMouseMove);
          window.removeEventListener("mouseup", handleMouseUp);
        };
        window.addEventListener("mousemove", handleMouseMove);
        window.addEventListener("mouseup", handleMouseUp);
      };

      const pct = (yearIdx / (YEARS.length - 1)) * 100;
      const themeColor = DEST_INFO[dest].color;

      return (
        <div style={S.container}>
          {/* Header */}
          <div style={S.header}>
            <div>
              <div style={S.badge}>
                <span style={{ display: "inline-block", width: 6, height: 6, borderRadius: "50%", background: "#818cf8", animation: "pulse 2s infinite" }} />
                Macro-Space Analytics v4.2
              </div>
              <h1 style={S.title}>Off-World Frontier Projections</h1>
              <div style={S.subtitle}>Decadal simulation of settlement economics, logistical cadence, and demographic scales (2025–2075)</div>
            </div>

            <div style={S.tabsContainer}>
              {["moon", "mars", "orbit"].map((d) => (
                <button key={d} style={S.tab(dest === d)} onClick={() => setDest(d)}>
                  {d === "moon" ? "🌕 Moon" : d === "mars" ? "🔴 Mars" : "🛰️ Orbit"}
                </button>
              ))}
            </div>
          </div>

          {/* Configuration & Controls */}
          <div style={S.grid}>
            {/* Scenario Chooser */}
            <div style={S.card}>
              <div style={{ fontSize: 12, fontWeight: 600, color: "#475569", marginBottom: 12, letterSpacing: 0.5, textTransform: "uppercase" }}>
                Simulation Path Trajectory
              </div>
              <div style={{ display: "flex", gap: 8 }}>
                <button style={S.scenBtn(scen === "opt", "#34d399")} onClick={() => setScen("opt")}>
                  Optimistic
                  <div style={{ fontSize: 10, fontWeight: 400, opacity: 0.7, marginTop: 2 }}>High Tech / Safe</div>
                </button>
                <button style={S.scenBtn(scen === "real", "#38bdf8")} onClick={() => setScen("real")}>
                  Realistic
                  <div style={{ fontSize: 10, fontWeight: 400, opacity: 0.7, marginTop: 2 }}>Steady Progress</div>
                </button>
                <button style={S.scenBtn(scen === "pess", "#f87171")} onClick={() => setScen("pess")}>
                  Pessimistic
                  <div style={{ fontSize: 10, fontWeight: 400, opacity: 0.7, marginTop: 2 }}>Stagnation Risks</div>
                </button>
              </div>
            </div>

            {/* Interactive Timeline Slider */}
            <div style={{ ...S.card, gridColumn: "span 2" }}>
              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "baseline" }}>
                <span style={{ fontSize: 12, fontWeight: 600, color: "#475569", letterSpacing: 0.5, textTransform: "uppercase" }}>Temporal Simulation Focus</span>
                <span style={{ fontSize: 22, fontWeight: 800, color: themeColor, fontFamily: "monospace" }}>{activeYear}</span>
              </div>

              <div ref={trackRef} style={S.sliderTrack} onMouseDown={handleTrackMouseDown}>
                <div style={{ absolute: "absolute", left: 0, top: 0, bottom: 0, width: `${pct}%`, background: `linear-gradient(to right, #1e3a8a, ${themeColor})`, borderRadius: 3, height: "100%" }} />
                <div style={S.sliderThumb(pct)} />
              </div>

              <div style={{ display: "flex", justifyContent: "space-between", padding: "0 2px" }}>
                {YEARS.map((y, i) => (
                  <span key={y} onClick={() => setYearIdx(i)} style={{ fontSize: 10, cursor: "pointer", fontWeight: i === yearIdx ? 700 : 400, color: i === yearIdx ? "#f8fafc" : "#334155", transition: "color 0.2s" }}>
                    {y}
                  </span>
                ))}
              </div>
            </div>
          </div>

          {/* Quick Metrics Flashcards */}
          <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(220px, 1fr))", gap: 16, marginBottom: 24 }}>
            <div style={{ ...S.card, borderLeft: `4px solid ${themeColor}`, background: DEST_INFO[dest].bg }}>
              <div style={{ fontSize: 11, fontWeight: 600, color: "#64748b", textTransform: "uppercase" }}>Payload Delivery Cost</div>
              <div style={{ fontSize: 24, fontWeight: 700, margin: "6px 0", color: "#f1f5f9" }}>
                {currentMetrics.cost === 0 ? "N/A" : `$${currentMetrics.cost.toLocaleString()}`} <span style={{ fontSize: 12, color: "#475569", fontWeight: 400 }}>/ kg</span>
              </div>
              <div style={{ fontSize: 11, color: "#475569" }}>Launch vehicle efficiency metric</div>
            </div>

            <div style={{ ...S.card, borderLeft: `4px solid ${themeColor}`, background: DEST_INFO[dest].bg }}>
              <div style={{ fontSize: 11, fontWeight: 600, color: "#64748b", textTransform: "uppercase" }}>Annual Cargo Supply</div>
              <div style={{ fontSize: 24, fontWeight: 700, margin: "6px 0", color: "#f1f5f9" }}>
                {currentMetrics.tonnage.toLocaleString()} <span style={{ fontSize: 12, color: "#475569", fontWeight: 400 }}>Tons</span>
              </div>
              <div style={{ fontSize: 11, color: "#475569" }}>Total outbound payload capacity</div>
            </div>

            <div style={{ ...S.card, borderLeft: `4px solid ${themeColor}`, background: DEST_INFO[dest].bg }}>
              <div style={{ fontSize: 11, fontWeight: 600, color: "#64748b", textTransform: "uppercase" }}>Permanent Population</div>
              <div style={{ fontSize: 24, fontWeight: 700, margin: "6px 0", color: "#f1f5f9" }}>
                {currentMetrics.population.toLocaleString()} <span style={{ fontSize: 12, color: "#475569", fontWeight: 400 }}>Souls</span>
              </div>
              <div style={{ fontSize: 11, color: "#475569" }}>On-site active colony base size</div>
            </div>

            <div style={{ ...S.card, borderLeft: `4px solid ${themeColor}`, background: DEST_INFO[dest].bg }}>
              <div style={{ fontSize: 11, fontWeight: 600, color: "#64748b", textTransform: "uppercase" }}>Mission Cadence</div>
              <div style={{ fontSize: 24, fontWeight: 700, margin: "6px 0", color: "#f1f5f9" }}>
                {currentMetrics.cadence.toLocaleString()} <span style={{ fontSize: 12, color: "#475569", fontWeight: 400 }}>/ Year</span>
              </div>
              <div style={{ fontSize: 11, color: "#475569" }}>Heavy-class arrivals annually</div>
            </div>
          </div>

          {/* Charts Layout */}
          <div style={{ display: "grid", gridTemplateColumns: "2fr 1fr", gap: 16, alignItems: "start" }}>
            
            {/* Primary Metrics Charts Grid */}
            <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 16 }}>
              
              {/* Cost Curve Chart */}
              <div style={S.card}>
                <div style={{ fontSize: 13, fontWeight: 600, color: "#94a3b8", marginBottom: 16 }}>Cost of Cargo Delivery ($ per kg)</div>
                <div style={{ width: "100%", height: 200 }}>
                  <ResponsiveContainer>
                    <AreaChart data={timeSeriesData} margin={{ top: 5, right: 5, left: -25, bottom: 0 }}>
                      <defs>
                        <linearGradient id="colorCost" x1="0" y1="0" x2="0" y2="1">
                          <stop offset="5%" stopColor={themeColor} stopOpacity={0.2}/>
                          <stop offset="95%" stopColor={themeColor} stopOpacity={0}/>
                        </linearGradient>
                      </defs>
                      <CartesianGrid strokeDasharray="3 3" stroke="#1e293b" vertical={false} />
                      <XAxis dataKey="year" stroke="#475569" fontSize={10} tickLine={false} />
                      <YAxis stroke="#475569" fontSize={10} tickLine={false} />
                      <Tooltip content={<CustomTooltip valPrefix="$" valSuffix="/kg" />} />
                      <Area type="monotone" dataKey="cost" stroke={themeColor} strokeWidth={2} fillOpacity={1} fill="url(#colorCost)" name="Cost" />
                    </AreaChart>
                  </ResponsiveContainer>
                </div>
              </div>

              {/* Tonnage Growth Chart */}
              <div style={S.card}>
                <div style={{ fontSize: 13, fontWeight: 600, color: "#94a3b8", marginBottom: 16 }}>Logistics Mass Influx (Tons / Yr)</div>
                <div style={{ width: "100%", height: 200 }}>
                  <ResponsiveContainer>
                    <BarChart data={timeSeriesData} margin={{ top: 5, right: 5, left: -20, bottom: 0 }}>
                      <CartesianGrid strokeDasharray="3 3" stroke="#1e293b" vertical={false} />
                      <XAxis dataKey="year" stroke="#475569" fontSize={10} tickLine={false} />
                      <YAxis stroke="#475569" fontSize={10} tickLine={false} />
                      <Tooltip content={<CustomTooltip valSuffix=" Tons" />} />
                      <Bar dataKey="tonnage" fill={themeColor} radius={[4, 4, 0, 0]} name="Mass Supply" />
                    </BarChart>
                  </ResponsiveContainer>
                </div>
              </div>

              {/* Comparative Total Population Scenario Chart */}
              <div style={{ ...S.card, gridColumn: "span 2" }}>
                <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 16 }}>
                  <div style={{ fontSize: 13, fontWeight: 600, color: "#94a3b8" }}>Colonial Populations Across Destinations</div>
                  <div style={{ fontSize: 11, background: "#1e293b", padding: "2px 8px", borderRadius: 4, color: "#94a3b8", textTransform: "capitalize" }}>
                    Scenario: {scen === "real" ? "Realistic Path" : scen === "opt" ? "Optimistic Path" : "Pessimistic Path"}
                  </div>
                </div>
                <div style={{ width: "100%", height: 240 }}>
                  <ResponsiveContainer>
                    <LineChart data={globalCompareData} margin={{ top: 5, right: 5, left: -15, bottom: 0 }}>
                      <CartesianGrid strokeDasharray="3 3" stroke="#1e293b" />
                      <XAxis dataKey="year" stroke="#475569" fontSize={10} />
                      <YAxis stroke="#475569" fontSize={10} />
                      <Tooltip content={<CustomTooltip valSuffix=" people" />} />
                      <Legend wrapperStyle={{ fontSize: 11, paddingTop: 10 }} />
                      <Line type="monotone" dataKey="moon" stroke={DEST_INFO.moon.color} strokeWidth={2} dot={{ r: 2 }} name="Luna Base" />
                      <Line type="monotone" dataKey="mars" stroke={DEST_INFO.mars.color} strokeWidth={2} dot={{ r: 2 }} name="Mars Alpha" />
                      <Line type="monotone" dataKey="orbit" stroke={DEST_INFO.orbit.color} strokeWidth={2} dot={{ r: 2 }} name="Orbital Hubs" />
                    </LineChart>
                  </ResponsiveContainer>
                </div>
              </div>

            </div>

            {/* Sidebar Context panel */}
            <div style={{ display: "flex", flexDirection: "column", gap: 16 }}>
              <div style={{ ...S.card, background: `linear-gradient(135deg, #0f172a 0%, ${DEST_INFO[dest].bg} 100%)` }}>
                <div style={{ display: "flex", alignItems: "center", gap: 8, marginBottom: 8 }}>
                  <span style={{ fontSize: 20 }}>{dest === "moon" ? "🌕" : dest === "mars" ? "🔴" : "🛰️"}</span>
                  <div style={{ fontSize: 16, fontWeight: 700, color: "#f8fafc" }}>{DEST_INFO[dest].name}</div>
                </div>
                <p style={{ fontSize: 12, color: "#94a3b8", margin: "0 0 16px 0", lineHeight: 1.5 }}>{DEST_INFO[dest].desc}</p>
                
                <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
                  <div style={S.metricBox}>
                    <span style={{ fontSize: 11, color: "#475569", fontWeight: 500 }}>Target Year</span>
                    <span style={{ fontSize: 12, fontWeight: 700, color: themeColor }}>{activeYear}</span>
                  </div>
                  <div style={S.metricBox}>
                    <span style={{ fontSize: 11, color: "#475569", fontWeight: 500 }}>Launch Cadence</span>
                    <span style={{ fontSize: 12, fontWeight: 700, color: "#f1f5f9" }}>~ Every {currentMetrics.cadence > 0 ? (365 / currentMetrics.cadence).toFixed(1) : "0"} Days</span>
                  </div>
                </div>
              </div>

              <div style={{ ...S.card, background: "#090F1C" }}>
                <div style={{ fontSize: 12, fontWeight: 600, color: "#64748B", marginBottom: 10, letterSpacing: 1, textTransform: "uppercase" }}>
                  What it knows
                </div>
                {[
                  ["💰", "Cost data", "2025–2075, all 3 destinations"],
                  ["📦", "Supply chain", "Cargo tonnage projections"],
                  ["👥", "Population", "Colony growth trajectories"],
                  ["🚀", "Launch freq.", "Mission cadence forecasts"],
                  ["🎯", "3 scenarios", "Opt / Realistic / Pessimistic"],
                ].map(([icon, label, sub]) => (
                  <div key={label} style={{ display: "flex", gap: 8, alignItems: "center", marginBottom: 8 }}>
                    <span style={{ fontSize: 14 }}>{icon}</span>
                    <div>
                      <div style={{ fontSize: 11, color: "#475569", fontWeight: 500 }}>{label}</div>
                      <div style={{ fontSize: 10, color: "#334155" }}>{sub}</div>
                    </div>
                  </div>
                ))}
              </div>
            </div>

          </div>

          <style>{`
            @keyframes pulse {
              0%, 80%, 100% { opacity: 0.2; transform: scale(0.8); }
              40% { opacity: 1; transform: scale(1); }
            }
          `}</style>
        </div>
      );
    }

    const root = ReactDOM.createRoot(document.getElementById("root"));
    root.render(<App />);
  </script>
